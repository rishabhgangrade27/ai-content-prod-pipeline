# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres (used by docker-compose and by Prisma) ---
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=pipeline
POSTGRES_DB=pipeline
# NOTE: mapped to host port 55432, not the default 5432 — on some Windows
# machines something (security software / a leftover local Postgres) sits on
# 5432 and corrupts the SCRAM auth handshake. 55432 avoids that; change if
# it collides with something on your own machine.
DATABASE_URL=postgresql://pipeline:pipeline@127.0.0.1:55432/pipeline

# --- Redis (used by docker-compose and, later, BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- MinIO / S3-compatible object storage ---
MINIO_ROOT_USER=pipeline
MINIO_ROOT_PASSWORD=pipeline123
MINIO_BUCKET=pipeline-assets
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=pipeline
S3_SECRET_ACCESS_KEY=pipeline123

# --- n8n ---
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/

# --- API server ---
API_PORT=3001
NODE_ENV=development

# --- MCP server (Stage 6) ---
API_BASE_URL=http://localhost:3001

# --- AI providers (Stage 2) ---
# Provider selectors — swap by changing these, not by editing call sites.
LLM_PROVIDER=claude
IMAGE_PROVIDER=fal-flux
TTS_PROVIDER=google-cloud-tts
MUSIC_PROVIDER=freesound

# Claude (script generation + structured scene breakdown) — cheap Haiku 4.5 tier.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# fal.ai (FLUX.1 [schnell] image generation, ~$0.003/megapixel) — https://fal.ai/dashboard/keys
FAL_KEY=

# Google Cloud Text-to-Speech (free tier: 4M chars/mo standard voices).
# Path to a service account JSON key with the Cloud Text-to-Speech API enabled.
GOOGLE_APPLICATION_CREDENTIALS=

# Freesound (background music/SFX, CC0/CC-BY only) — https://freesound.org/apiv2/apply
FREESOUND_API_KEY=
