{
  "name": "ai-content-production-pipeline",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "prisma:generate": "npm run generate -w packages/db",
    "prisma:migrate": "npm run migrate -w packages/db",
    "prisma:studio": "npm run studio -w packages/db"
  }
}
